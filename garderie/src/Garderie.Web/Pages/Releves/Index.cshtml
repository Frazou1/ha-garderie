@page
@model Garderie.Web.Pages.Releves.IndexModel
@{
    ViewData["Title"] = "Relevés 24";
    var a = Model.AnneeAffichee;
}
<div class="entete-page">
    <div>
        <h1 class="titre-page">Relevés 24 @a</h1>
        <p class="sous-titre">Frais de garde payés en @a · à remettre aux parents et à Revenu Québec au plus tard le 28 février @(a + 1)</p>
    </div>
    <nav class="nav-semaine" aria-label="Changer d'année">
        <a class="btn btn-rond" asp-page="Index" asp-route-annee="@(a - 1)" aria-label="Année précédente">‹</a>
        <a class="btn btn-rond" asp-page="Index" asp-route-annee="@(a + 1)" aria-label="Année suivante">›</a>
    </nav>
</div>

@if (Model.Manque.Count > 0)
{
    <p class="bulle bulle-erreur">Avant de produire les relevés, complétez dans <a asp-page="/Parametres" asp-fragment="rl24">Réglages</a> :
        @string.Join(", ", Model.Manque).</p>
}

@if (Model.Propositions.Count == 0)
{
    <div class="carte vide"><p class="mb-0">Aucun frais de garde payé en @a (aucun jour de présence, d'absence ou de fermeture payé).</p></div>
}
else
{
    <div class="liste-enfants">
        @foreach (var p in Model.Propositions)
        {
            var r = p.Dernier;
            <div class="tuile-ligne">
                <div class="tuile-enfant">
                    <span class="details">
                        <span class="nom d-block">@p.Prenom @p.Nom</span>
                        <span class="info d-block">
                            @foreach (var e in p.Enfants)
                            {
                                <span class="me-2">@e.Prenom : @e.Jours j · @Affichage.Argent(e.Montant)</span>
                            }
                            @if (r is null)
                            {
                                <span class="badge text-bg-warning">à produire</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">no @r.Numero@(r.Code == "A" ? " (modifié)" : "")</span>
                                <span class="small text-muted">le @Affichage.Horodatage(r.CreeLe)</span>
                            }
                        </span>
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @if (r is not null)
                    {
                        <a class="btn btn-sm btn-doux" asp-page-handler="Pdf" asp-route-id="@r.Id" target="_blank" rel="noopener">Afficher</a>
                        <a class="btn btn-sm btn-doux" asp-page-handler="Pdf" asp-route-id="@r.Id" asp-route-telecharger="true">Télécharger</a>
                    }
                    <a class="btn btn-sm @(r is null ? "btn-primary" : "btn-outline-secondary")" asp-page="Preparer" asp-route-annee="@a" asp-route-parentId="@p.ParentId">
                        @(r is null ? "Préparer" : "Modifier")</a>
                </div>
            </div>
        }
    </div>

    <section class="carte mt-3">
        <h2 class="h5">Sommaire 24</h2>
        <p class="mb-2">@Model.Totaux.Releves relevé(s) produit(s) sur @Model.Propositions.Count · @Model.Totaux.Enfants enfant(s) ·
            @Model.Totaux.Jours jour(s) · @Affichage.Argent(Model.Totaux.Admissible) donnant droit au crédit (case E).</p>
        @if (Model.Totaux.Releves > 0 && Model.Manque.Count == 0)
        {
            <p class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" asp-page-handler="Sommaire" asp-route-annee="@a" target="_blank" rel="noopener">Afficher le sommaire 24</a>
                <a class="btn btn-doux" asp-page-handler="Sommaire" asp-route-annee="@a" asp-route-telecharger="true">Télécharger</a>
            </p>
        }
        <p class="small text-muted mb-0">Imprimez le sommaire, signez-le et postez-le à Revenu Québec avec la copie 1 (page 1) de chaque relevé,
            au plus tard le dernier jour de février : 3800, rue de Marly, Québec (Québec) G1X 4A5, ou, pour Montréal, Laval, les Laurentides,
            Lanaudière et la Montérégie, C. P. 3000, succursale Place-Desjardins, Montréal (Québec) H5B 1A4.
            Remettez la copie 2 (page 2) à chaque parent. Produisez tous les relevés avant d'imprimer le sommaire.</p>
    </section>
}
