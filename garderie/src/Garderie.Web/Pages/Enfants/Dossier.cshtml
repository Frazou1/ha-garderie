@page "{id:int}"
@model Garderie.Web.Pages.Enfants.DossierModel
@using Garderie.Web.Pages.Shared
@{
    var e = Model.Enfant;
    ViewData["Title"] = e.NomComplet;
    var photoEnfant = e.PhotoDocumentId is { } photoId ? Url.Page("Dossier", "Document", new { id = e.Id, documentId = photoId, apercu = true }) : null;
    var avatarEnfant = new AvatarVue(e.NomComplet, Affichage.Initiales(e.Prenom, e.Nom), e.Id, photoEnfant, "av-lg");
    AvatarVue AvatarParent(Parent p) => new(p.NomComplet, Affichage.Initiales(p.Prenom, p.Nom), p.Id + 2,
        p.PhotoFichier is null ? null : Url.Page("Dossier", "PhotoParent", new { id = e.Id, parentId = p.Id }), "av-md");
    AvatarVue AvatarContact(Contact c)
    {
        var mots = c.Nom.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initiales = Affichage.Initiales(mots.FirstOrDefault() ?? "", mots.Length > 1 ? mots[^1] : "");
        return new(c.Nom, initiales, c.Id + 4,
            c.PhotoFichier is null ? null : Url.Page("Dossier", "PhotoContact", new { id = e.Id, contactId = c.Id }), "av-md");
    }
    PhotoModifiableVue PhotoEnfant() => new(avatarEnfant, e.Id, "Photo", photoEnfant is null ? "Ajouter une photo" : "Changer la photo");
    PhotoModifiableVue PhotoParent(Parent p) => new(AvatarParent(p), e.Id, "PhotoParent", "Photo de " + p.Prenom, "parentId", p.Id);
    PhotoModifiableVue PhotoContact(Contact c) => new(AvatarContact(c), e.Id, "PhotoContact", "Photo de " + c.Nom, "contactId", c.Id);
}
<div class="entete-fiche">
    @if (Model.Archive)
    {
        <partial name="_Avatar" model="avatarEnfant" />
    }
    else
    {
        <partial name="_PhotoModifiable" model="PhotoEnfant()" />
    }
    <div class="identite">
        <h1>@e.NomComplet</h1>
        @if (Model.Archive)
        {
            <span class="badge text-bg-dark">Ancien · parti le @Affichage.Date(e.DateFin)</span>
        }
        else if (!e.EstInscritLe(Model.Aujourdhui))
        {
            <span class="badge text-bg-secondary">Non inscrit aujourd'hui</span>
        }
        @foreach (var a in e.Allergies.Where(a => a.Gravite == Gravite.Severe))
        {
            <span class="badge text-bg-danger">Allergie sévère : @a.Description</span>
        }
    </div>
    @if (!Model.Archive)
    {
        <div class="d-flex flex-wrap gap-2 align-items-start">
            <a class="btn btn-outline-primary" asp-page="Edition" asp-route-id="@e.Id">Modifier l'identité</a>
            <details class="archiver">
                <summary class="btn btn-outline-secondary">Archiver</summary>
                <form method="post" asp-page-handler="Archiver" asp-route-id="@e.Id" class="carte mt-2 confirmer"
                      data-confirmer="Archiver le dossier de @e.NomComplet ? Il passera en lecture seule après le dernier jour.">
                    <label class="form-label small mb-1" for="dernierJour">Dernier jour de fréquentation</label>
                    <input class="form-control mb-2" type="date" id="dernierJour" name="dernierJour" required
                           min="@e.DateDebut.ToString("yyyy-MM-dd")" value="@Model.Aujourdhui.AddDays(-1).ToString("yyyy-MM-dd")" />
                    <p class="small text-muted mb-2">Le lendemain, le dossier passe aux anciens (lecture seule), conservé pour l'impôt.
                        « Réactiver » l'annule.</p>
                    <button type="submit" class="btn btn-primary btn-sm">Archiver le dossier</button>
                </form>
            </details>
        </div>
    }
</div>

@if (Model.Archive)
{
    <div class="aide d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="me-auto">Dossier archivé en <strong>lecture seule</strong> : conservé pour l'impôt (relevé 24) et les
            vérifications. Les documents restent téléchargeables et le NAS consultable.</span>
        <form method="post" asp-page-handler="Reactiver" asp-route-id="@e.Id" class="confirmer" data-confirmer="Réactiver le dossier de @e.NomComplet (retirer la date de fin) ?">
            <button class="btn btn-sm btn-outline-primary" type="submit">Réactiver</button>
        </form>
    </div>
}

<div class="row g-3 @(Model.Archive ? "archive" : "")">
    <!-- Identite / Identity -->
    <section class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Identité</div>
            <div class="card-body">
                <dl class="row mb-0 small-dl">
                    <dt class="col-5">Naissance</dt><dd class="col-7">@Affichage.Date(e.DateNaissance)</dd>
                    <dt class="col-5">Sexe</dt><dd class="col-7">@Affichage.Sexe(e.Sexe)</dd>
                    <dt class="col-5">Adresse</dt><dd class="col-7">@(e.Adresse ?? "—")</dd>
                    <dt class="col-5">Téléphone</dt><dd class="col-7">@(e.Telephone ?? "—")</dd>
                    <dt class="col-5">NAM</dt><dd class="col-7">@(Model.NamMasque ?? "—")</dd>
                    <dt class="col-5">Portail (La Place 0-5)</dt><dd class="col-7">@(e.NumeroPortail ?? "—")</dd>
                    <dt class="col-5">Fréquentation</dt><dd class="col-7">du @Affichage.Date(e.DateDebut) @(e.DateFin is null ? "" : $"au {Affichage.Date(e.DateFin)}")</dd>
                    @if (e.Notes is not null)
                    {
                        <dt class="col-5">Notes</dt><dd class="col-7 texte-libre">@e.Notes</dd>
                    }
                </dl>
            </div>
        </div>
    </section>

    <!-- Contrat / Contract -->
    <section class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center">
                <span class="me-auto">Contrat (entente de service)</span>
                <a class="btn btn-sm btn-doux" asp-page="/Contrats/Index">Contrats</a>
            </div>
            <div class="card-body">
                @if (Model.Contrat is { } contrat)
                {
                    <p class="mb-2"><span class="badge @Affichage.ClasseEtatContrat(contrat.Etat)">@Affichage.Nom(contrat.Etat)</span>
                        du @Affichage.Date(contrat.Debut) au @Affichage.Date(contrat.Fin)</p>
                    <a class="btn btn-sm btn-primary" asp-page="/Contrats/Contrat" asp-route-id="@contrat.Id">Ouvrir le contrat</a>
                }
                else
                {
                    <p class="text-muted mb-2">Aucun contrat.</p>
                    <form method="post" asp-page="/Contrats/Index" asp-page-handler="Creer" class="modif">
                        <input type="hidden" name="enfantId" value="@e.Id" />
                        <button class="btn btn-sm btn-primary" type="submit">+ Préparer le contrat</button>
                    </form>
                }
            </div>
        </div>
    </section>

    <!-- Parents -->
    <section class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center">
                <span class="me-auto">Parents / responsables</span>
                <a class="btn btn-sm btn-primary modif" asp-page="Parent" asp-route-enfantId="@e.Id">+ Ajouter</a>
            </div>
            <ul class="list-group list-group-flush">
                @if (e.Parents.Count == 0)
                {
                    <li class="list-group-item text-muted">Aucun parent.</li>
                }
                @foreach (var lien in e.Parents.OrderBy(p => p.Ordre))
                {
                    var p = lien.Parent;
                    <li class="list-group-item">
                        <div class="personne">
                            @if (Model.Archive)
                            {
                                <partial name="_Avatar" model="AvatarParent(p)" />
                            }
                            else
                            {
                                <partial name="_PhotoModifiable" model="PhotoParent(p)" />
                            }
                            <div class="me-auto">
                                <div class="fw-bold">@p.NomComplet <span class="text-muted fw-normal">(@lien.Lien)</span>
                                    @if (lien.EstPayeur) { <span class="badge text-bg-info">Payeur</span> }
                                </div>
                                <div class="small">
                                    @if (p.Telephone1 is not null) { <a href="tel:@p.Telephone1">@p.Telephone1</a> }
                                    @if (p.Telephone2 is not null) { <span> · <a href="tel:@p.Telephone2">@p.Telephone2</a></span> }
                                    @if (p.TelephoneAutreParent is not null) { <span> · papa : <a href="tel:@p.TelephoneAutreParent">@p.TelephoneAutreParent</a></span> }
                                    @if (p.Courriel is not null) { <span> · @p.Courriel</span> }
                                </div>
                                <div class="small text-muted">NAS : @(p.NasChiffre is null ? "non saisi" : "enregistré (chiffré)")</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 justify-content-end mt-2">
                            <a class="btn btn-sm btn-doux" asp-page="Parent" asp-route-enfantId="@e.Id" asp-route-parentId="@p.Id">@(Model.Archive ? "Voir" : "Modifier")</a>
                            <form method="post" asp-page-handler="RetirerParent" asp-route-id="@e.Id" class="confirmer" data-confirmer="Retirer @p.NomComplet du dossier ?">
                                <input type="hidden" name="parentId" value="@p.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Retirer</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </section>

    <!-- Contacts -->
    <section class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Personnes autorisées et contacts d'urgence</div>
            <ul class="list-group list-group-flush">
                @foreach (var c in e.Contacts.OrderBy(c => c.Ordre))
                {
                    <li class="list-group-item personne">
                        @if (Model.Archive)
                        {
                            <partial name="_Avatar" model="AvatarContact(c)" />
                        }
                        else
                        {
                            <partial name="_PhotoModifiable" model="PhotoContact(c)" />
                        }
                        <div class="me-auto">
                            <span class="fw-bold">@c.Nom</span> @if (c.Lien is not null) { <span class="text-muted">(@c.Lien)</span> }
                            <div class="small">
                                @if (c.Telephone is not null) { <a href="tel:@c.Telephone">@c.Telephone</a> }
                                @if (c.PeutVenirChercher) { <span class="badge text-bg-success">Peut venir chercher</span> }
                                @if (c.ContactUrgence) { <span class="badge text-bg-warning">Urgence</span> }
                            </div>
                        </div>
                        <form method="post" asp-page-handler="SupprimerContact" asp-route-id="@e.Id" class="confirmer" data-confirmer="Retirer @c.Nom ?">
                            <input type="hidden" name="contactId" value="@c.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Retirer</button>
                        </form>
                    </li>
                }
                <li class="list-group-item">
                    <form method="post" asp-page-handler="Contact" asp-route-id="@e.Id" class="row g-2">
                        <div class="col-sm-5"><input name="contact.Nom" class="form-control form-control-sm" placeholder="Nom" required maxlength="200" /></div>
                        <div class="col-sm-3"><input name="contact.Lien" class="form-control form-control-sm" placeholder="Lien" maxlength="50" /></div>
                        <div class="col-sm-4"><input name="contact.Telephone" type="tel" class="form-control form-control-sm" placeholder="Téléphone" maxlength="30" /></div>
                        <div class="col-auto form-check ms-2">
                            <input class="form-check-input" type="checkbox" name="contact.PeutVenirChercher" value="true" id="c-chercher" />
                            <label class="form-check-label small" for="c-chercher">Peut venir chercher</label>
                        </div>
                        <div class="col-auto form-check ms-2">
                            <input class="form-check-input" type="checkbox" name="contact.ContactUrgence" value="true" id="c-urgence" />
                            <label class="form-check-label small" for="c-urgence">Contact d'urgence</label>
                        </div>
                        <div class="col-auto ms-auto"><button class="btn btn-sm btn-primary" type="submit">Ajouter</button></div>
                    </form>
                </li>
            </ul>
        </div>
    </section>

    <!-- Horaire / Schedule -->
    <section class="col-lg-6">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center">
                <span class="me-auto">Horaire prévu</span>
                <a class="btn btn-sm btn-primary modif" asp-page="Horaire" asp-route-id="@e.Id">Modifier</a>
            </div>
            <div class="card-body">
                @if (Model.HoraireDepuis is null)
                {
                    <p class="text-muted mb-0">Aucun horaire.</p>
                }
                else
                {
                    <p class="small text-muted">Pour information, depuis le @Affichage.Date(Model.HoraireDepuis). Les présences utilisent la date de début de fréquentation.</p>
                    <ul class="list-unstyled mb-0">
                        @foreach (var j in Affichage.JoursSemaine)
                        {
                            var h = Model.HoraireActuel.FirstOrDefault(x => x.Jour == j);
                            if (h is not null && (h.Matin || h.Pm))
                            {
                                <li>@Affichage.Jour(j) : @Affichage.ResumeJour(h)</li>
                            }
                        }
                    </ul>
                }
            </div>
        </div>
    </section>

    <!-- Sante / Health -->
    <section class="col-12">
        <div class="card">
            <div class="card-header">Santé</div>
            <div class="card-body">
                @if (e.NotesSante is not null)
                {
                    <p class="texte-libre">@e.NotesSante</p>
                }
                <div class="row g-4">
                    <div class="col-lg-6">
                        <h2 class="h6">Allergies</h2>
                        <ul class="list-group mb-2">
                            @foreach (var a in e.Allergies)
                            {
                                <li class="list-group-item d-flex align-items-start gap-2">
                                    <div class="me-auto">
                                        <span class="fw-semibold">@a.Description</span>
                                        <span class="badge @(a.Gravite == Gravite.Severe ? "text-bg-danger" : a.Gravite == Gravite.Moderee ? "text-bg-warning" : "text-bg-secondary")">@Affichage.Gravite(a.Gravite)</span>
                                        @if (a.Mesures is not null) { <div class="small texte-libre">@a.Mesures</div> }
                                    </div>
                                    <form method="post" asp-page-handler="SupprimerAllergie" asp-route-id="@e.Id" class="confirmer" data-confirmer="Retirer cette allergie ?">
                                        <input type="hidden" name="allergieId" value="@a.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Retirer</button>
                                    </form>
                                </li>
                            }
                        </ul>
                        <form method="post" asp-page-handler="Allergie" asp-route-id="@e.Id" class="row g-2">
                            <div class="col-sm-7"><input name="allergie.Description" class="form-control form-control-sm" placeholder="Allergie (ex. arachides)" required maxlength="200" /></div>
                            <div class="col-sm-5">
                                <select name="allergie.Gravite" class="form-select form-select-sm">
                                    <option value="Legere">Légère</option>
                                    <option value="Moderee" selected>Modérée</option>
                                    <option value="Severe">Sévère</option>
                                </select>
                            </div>
                            <div class="col-12"><input name="allergie.Mesures" class="form-control form-control-sm" placeholder="Mesures (ex. EpiPen dans le sac)" maxlength="1000" /></div>
                            <div class="col-12"><button class="btn btn-sm btn-primary" type="submit">Ajouter l'allergie</button></div>
                        </form>
                    </div>
                    <div class="col-lg-6">
                        <h2 class="h6">Médicaments autorisés</h2>
                        <ul class="list-group mb-2">
                            @foreach (var m in e.Medicaments)
                            {
                                <li class="list-group-item d-flex align-items-start gap-2">
                                    <div class="me-auto">
                                        <span class="fw-semibold">@m.Nom</span> @if (m.Posologie is not null) { <span>— @m.Posologie</span> }
                                        <div class="small text-muted">
                                            @m.Raison
                                            @if (m.DateDebut is not null || m.DateFin is not null) { <span>(@Affichage.Date(m.DateDebut) → @Affichage.Date(m.DateFin))</span> }
                                        </div>
                                    </div>
                                    <form method="post" asp-page-handler="SupprimerMedicament" asp-route-id="@e.Id" class="confirmer" data-confirmer="Retirer ce médicament ?">
                                        <input type="hidden" name="medicamentId" value="@m.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Retirer</button>
                                    </form>
                                </li>
                            }
                        </ul>
                        <form method="post" asp-page-handler="Medicament" asp-route-id="@e.Id" class="row g-2">
                            <div class="col-sm-6"><input name="medicament.Nom" class="form-control form-control-sm" placeholder="Médicament" required maxlength="200" /></div>
                            <div class="col-sm-6"><input name="medicament.Posologie" class="form-control form-control-sm" placeholder="Posologie" maxlength="200" /></div>
                            <div class="col-12"><input name="medicament.Raison" class="form-control form-control-sm" placeholder="Raison" maxlength="300" /></div>
                            <div class="col-sm-6"><label class="form-label small mb-0">Du</label><input name="medicament.DateDebut" type="date" class="form-control form-control-sm" /></div>
                            <div class="col-sm-6"><label class="form-label small mb-0">Au</label><input name="medicament.DateFin" type="date" class="form-control form-control-sm" /></div>
                            <div class="col-12"><button class="btn btn-sm btn-primary" type="submit">Ajouter le médicament</button></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Documents : liste simple (nom, type et date), actions dans le menu « ⋯ » / Simple list, actions in a menu -->
    <section class="col-12">
        <div class="card">
            <div class="card-header">Documents</div>
            <ul class="liste-docs">
                @foreach (var d in e.Documents.OrderBy(d => d.Type == TypeDocument.Photo).ThenByDescending(d => d.TeleverseLe))
                {
                    var archive = Model.Archives.Contains(d.Id);
                    var nom = System.IO.Path.GetFileNameWithoutExtension(d.NomOriginal);
                    var afficher = Url.Page("Dossier", "Document", new { id = e.Id, documentId = d.Id, afficher = true });
                    var icone = d.TypeContenu.StartsWith("image/") ? "M4 5h16v14H4zM4 15l4-4 4 4 3-3 5 5M15 9h.01" : "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h4";
                    var meta = Affichage.Nom(d.Type) + " · " + Affichage.Date(DateOnly.FromDateTime(Temps.VersLocal(d.TeleverseLe))) + (d.Note is null ? "" : " · " + d.Note);
                    <li class="doc">
                        <svg class="doc-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="@icone" /></svg>
                        <div class="doc-texte">
                            <a class="doc-nom" href="@afficher" target="_blank" rel="noopener">@nom</a>
                            <div class="doc-meta">@meta</div>
                        </div>
                        <details class="doc-menu">
                            <summary aria-label="Options de « @nom »">⋯</summary>
                            <div class="doc-panneau">
                                <a class="btn btn-sm btn-doux w-100" href="@afficher" target="_blank" rel="noopener">Afficher</a>
                                <a class="btn btn-sm btn-doux w-100" href="@Url.Page("Dossier", "Document", new { id = e.Id, documentId = d.Id })">Télécharger</a>
                                @if (d.Type == TypeDocument.Releve24 && archive)
                                {
                                    <a class="btn btn-sm btn-outline-secondary w-100" asp-page="/Releves/Index">Gérer dans Relevés 24</a>
                                }
                                else if (archive)
                                {
                                    <p class="small text-muted mb-0">Archive signée : elle reste au dossier.</p>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="ModifierDocument" asp-route-id="@e.Id" class="d-grid gap-1">
                                        <input type="hidden" name="documentId" value="@d.Id" />
                                        <label class="small mb-0" for="nom-@d.Id">Nom</label>
                                        <input class="form-control form-control-sm" id="nom-@d.Id" name="nom" value="@nom" maxlength="200" required />
                                        <label class="small mb-0" for="note-@d.Id">Note</label>
                                        <input class="form-control form-control-sm" id="note-@d.Id" name="note" value="@d.Note" maxlength="500" />
                                        <button class="btn btn-sm btn-primary" type="submit">Enregistrer</button>
                                    </form>
                                    <form method="post" asp-page-handler="SupprimerDocument" asp-route-id="@e.Id" class="confirmer" data-confirmer="Supprimer définitivement « @nom » ?">
                                        <input type="hidden" name="documentId" value="@d.Id" />
                                        <button class="btn btn-sm btn-outline-danger w-100" type="submit">Supprimer</button>
                                    </form>
                                }
                            </div>
                        </details>
                    </li>
                }
                @if (e.Documents.Count == 0)
                {
                    <li class="doc doc-vide">Aucun document.</li>
                }
            </ul>
            <details class="doc-ajout">
                <summary>+ Ajouter un document</summary>
                <form method="post" asp-page-handler="Document" asp-route-id="@e.Id" enctype="multipart/form-data" class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small mb-0" for="doc-type">Type</label>
                        <select name="type" id="doc-type" class="form-select form-select-sm">
                            @foreach (var t in Enum.GetValues<TypeDocument>())
                            {
                                <option value="@t">@Affichage.Nom(t)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="doc-fichier">Fichier (PDF, JPG, PNG, HEIC — 15 Mo max)</label>
                        <input type="file" name="fichier" id="doc-fichier" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.heic,application/pdf,image/*" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0" for="doc-note">Note (facultatif)</label>
                        <input name="note" id="doc-note" class="form-control form-control-sm" maxlength="500" />
                    </div>
                    <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit">Ajouter</button></div>
                </form>
            </details>
        </div>
    </section>
</div>

<details class="card border-danger mt-4">
    <summary class="card-header text-danger">Supprimer ce dossier</summary>
    <div class="card-body">
        <p class="small mb-2">
            Efface définitivement l'enfant, ses contacts, sa santé, son horaire, ses présences et ses documents,
            ainsi que les parents qui n'ont pas d'autre enfant inscrit. Le journal est conservé.
            Pour un enfant qui quitte la garderie, indiquez plutôt une date de fin dans « Modifier l'identité ».
        </p>
        <form method="post" asp-page-handler="SupprimerEnfant" asp-route-id="@e.Id" class="row g-2 align-items-end confirmer" data-confirmer="Supprimer définitivement le dossier de @e.NomComplet ?">
            <div class="col-sm-6">
                <label class="form-label small mb-0" for="confirmation">Tapez le prénom « @e.Prenom » pour confirmer</label>
                <input name="confirmation" id="confirmation" class="form-control form-control-sm" autocomplete="off" required />
            </div>
            <div class="col-sm-6"><button class="btn btn-sm btn-danger" type="submit">Supprimer le dossier</button></div>
        </form>
    </div>
</details>
