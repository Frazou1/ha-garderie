@page "{id:int}"
@model Garderie.Web.Pages.Contrats.ContratModel
@{
    var c = Model.Contrat;
    var e = c.Enfant;
    var i = Model.Infos;
    ViewData["Title"] = "Contrat de " + e.Prenom;
    var resiliationEnCours = c.Etat == EtatContrat.Signe && c.ResilieLe is not null;
    var but = resiliationEnCours ? ButLien.Resiliation : ButLien.Signature;
    var copies = (Url.Page("Contrat", "Copie", new { id = c.Id })!, Model.Parent?.Parent.Courriel, Model.EnvoiPossible);
}
<div class="entete-page">
    <div>
        <h1 class="titre-page">Contrat de @e.Prenom @e.Nom</h1>
        <p class="sous-titre">Du @Affichage.Date(c.Debut) au @Affichage.Date(c.Fin) · <span class="badge @Affichage.ClasseEtatContrat(c.Etat)">@Affichage.Nom(c.Etat)</span></p>
    </div>
    <a class="btn btn-doux btn-sm" asp-page="Index">Tous les contrats</a>
</div>

@if (TempData["Lien"] is string lien)
{
    <div class="carte">
        <p class="fw-bold mb-1">Lien à envoyer au parent (affiché une seule fois, valide 14 jours)</p>
        <input class="form-control" readonly value="@lien" aria-label="Lien" />
    </div>
}

@if (c.Etat == EtatContrat.Brouillon)
{
    <section class="carte">
        <h2 class="h5">1. Durée du contrat</h2>
        <form method="post" asp-page-handler="Dates" asp-route-id="@c.Id" class="row g-2 align-items-end">
            <div class="col-sm-4"><label class="form-label small mb-0" for="debut">Prend effet le</label>
                <input type="date" class="form-control" id="debut" name="debut" value="@c.Debut.ToString("yyyy-MM-dd")" required /></div>
            <div class="col-sm-4"><label class="form-label small mb-0" for="fin">Prend fin le</label>
                <input type="date" class="form-control" id="fin" name="fin" value="@c.Fin.ToString("yyyy-MM-dd")" required /></div>
            <div class="col-sm-4"><button class="btn btn-doux w-100" type="submit">Enregistrer les dates</button></div>
        </form>
        <p class="small text-muted mt-2 mb-0">Fermetures reprises de la page Fermetures pour cette période :
            @(i.Fermetures.Count == 0 ? "aucune (ajoutez-les, ex. jours fériés)." : $"{i.Fermetures.Count}.")
            <a asp-page="/Fermetures">Fermetures</a></p>
    </section>

    <section class="carte">
        <h2 class="h5">2. Signature du parent</h2>
        @if (!Model.RegieDisponible)
        {
            <p class="bulle bulle-erreur">La régie interne n'est pas téléversée. Le parent atteste l'avoir lue : téléversez-la dans
                <a asp-page="/Parametres">Réglages</a> avant d'envoyer le contrat.</p>
        }
        @if (Model.Parent is null)
        {
            <p class="aide mb-0">Ajoutez d'abord un parent au <a asp-page="/Enfants/Dossier" asp-route-id="@e.Id">dossier</a>.</p>
        }
        else
        {
            <p class="small">@Model.Parent.Parent.NomComplet complète ses renseignements (adresse, téléphones, NAS), lit l'entente et la
                régie interne, puis signe. @(Model.LienActif ? "Un lien est déjà en cours ; un nouvel envoi l'annule." : "")</p>
            <partial name="_ActionsParent" model="(c.Id, ButLien.Signature, Model.EnvoiPossible, Model.UrlPubliqueConfiguree, Model.Parent.Parent.Courriel, Model.LienActif)" />
        }
    </section>
}
else if (c.Etat == EtatContrat.SigneParent)
{
    <section class="carte">
        <h2 class="h5">Contresigner</h2>
        <p class="small">Signé par @c.SignataireParent le @Affichage.Horodatage(c.SigneParentLe!.Value)@(c.SigneSurPlace ? " (sur place)" : "").
            Vérifiez l'aperçu, puis signez. Une copie du contrat signé sera envoyée au parent.</p>
        <form method="post" asp-page-handler="Contresigner" asp-route-id="@c.Id" class="form-signature">
            <canvas class="pad-signature" width="600" height="200" aria-label="Signez ici avec le doigt"></canvas>
            <input type="hidden" name="signature" class="valeur-signature" />
            <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-outline-secondary effacer-signature">Effacer</button>
                <button type="submit" class="btn btn-primary ms-auto">Signer le contrat</button>
            </div>
        </form>
        <form method="post" asp-page-handler="Reprendre" asp-route-id="@c.Id" class="confirmer mt-3"
              data-confirmer="Reprendre le contrat ? La signature du parent sera annulée.">
            <button class="btn btn-sm btn-outline-danger" type="submit">Reprendre (corriger avant de signer)</button>
        </form>
    </section>
}
else if (c.Etat == EtatContrat.Signe)
{
    <section class="carte">
        <h2 class="h5">Contrat signé</h2>
        <p class="small mb-0">Parent : @c.SignataireParent, le @Affichage.Horodatage(c.SigneParentLe!.Value). Éducatrice : le @Affichage.Horodatage(c.SigneRsgeLe!.Value).
            Le PDF est rangé dans les documents du dossier.</p>
    </section>
    <section class="carte">
        <h2 class="h5">Résiliation</h2>
        @if (resiliationEnCours)
        {
            <p class="small">Résiliation à compter du <strong>@Affichage.Date(c.ResilieLe)</strong> : le parent doit signer la formule.
                @(Model.LienActif ? "Un lien est en cours." : "")</p>
            <partial name="_ActionsParent" model="(c.Id, ButLien.Resiliation, Model.EnvoiPossible, Model.UrlPubliqueConfiguree, Model.Parent?.Parent.Courriel, Model.LienActif)" />
            <form method="post" asp-page-handler="AnnulerResiliation" asp-route-id="@c.Id" class="mt-2">
                <button class="btn btn-sm btn-outline-secondary" type="submit">Annuler la résiliation</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Resilier" asp-route-id="@c.Id" class="row g-2 align-items-end confirmer"
                  data-confirmer="Préparer la résiliation du contrat de @e.Prenom ?">
                <div class="col-sm-6"><label class="form-label small mb-0" for="date">Résilié à compter du</label>
                    <input type="date" class="form-control" id="date" name="date" value="@Temps.Aujourdhui().ToString("yyyy-MM-dd")" /></div>
                <div class="col-sm-6"><button class="btn btn-outline-danger w-100" type="submit">Résilier le contrat</button></div>
            </form>
            <p class="small text-muted mt-2 mb-0">Le parent signe ensuite la formule de résiliation ; la date de fin de l'enfant est alors mise à jour (dossier archivé).</p>
        }
    </section>
}
else
{
    <section class="carte">
        <h2 class="h5">Contrat résilié</h2>
        <p class="small mb-0">Résilié à compter du @Affichage.Date(c.ResilieLe), formule signée par @c.SignataireResiliation le @Affichage.Horodatage(c.ResiliationSigneeLe!.Value).</p>
        <p class="mt-2 mb-0"><a class="btn btn-sm btn-doux" asp-page-handler="Pdf" asp-route-id="@c.Id" asp-route-resiliation="true">Télécharger la résiliation</a></p>
    </section>
}

<section class="carte">
    <h2 class="h5">Contenu</h2>
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-sm btn-doux" asp-page-handler="Pdf" asp-route-id="@c.Id" asp-route-afficher="true" target="_blank" rel="noopener">@(c.DocumentId is null ? "Afficher l'aperçu" : "Afficher le contrat signé")</a>
        <a class="btn btn-sm btn-doux" asp-page-handler="Pdf" asp-route-id="@c.Id">Télécharger</a>
        @if (c.DocumentResiliationId is not null)
        {
            <a class="btn btn-sm btn-doux" asp-page-handler="Pdf" asp-route-id="@c.Id" asp-route-resiliation="true" asp-route-afficher="true" target="_blank" rel="noopener">Afficher la résiliation</a>
        }
    </div>
    @if (c.DocumentId is not null)
    {
        <div class="mb-3"><partial name="_Copies" model="copies" /></div>
    }
    <dl class="row small-dl small mb-0">
        <dt class="col-sm-4">Parent</dt><dd class="col-sm-8">@(string.IsNullOrEmpty(i.ParentNom) ? "—" : i.ParentNom) @(i.ParentLien is null ? "" : $"({i.ParentLien})")</dd>
        <dt class="col-sm-4">Fermetures</dt><dd class="col-sm-8">@(i.Fermetures.Count == 0 ? "—" : string.Join(" · ", i.Fermetures))</dd>
        <dt class="col-sm-4">Vacances du parent</dt><dd class="col-sm-8">@(i.VacancesParent ?? "—")</dd>
    </dl>
</section>

@if (c.Etat == EtatContrat.Brouillon)
{
    <form method="post" asp-page-handler="Supprimer" asp-route-id="@c.Id" class="confirmer" data-confirmer="Supprimer ce brouillon de contrat ?">
        <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer le brouillon</button>
    </form>
}
