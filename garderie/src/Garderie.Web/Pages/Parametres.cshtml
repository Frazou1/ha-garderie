@page
@model ParametresModel
@{
    ViewData["Title"] = "Réglages";
}
<div class="entete-page">
    <div>
        <h1 class="titre-page">Réglages</h1>
        <p class="sous-titre">Garderie, fiches d'assiduité et courriel</p>
    </div>
    <a class="btn btn-doux btn-sm" asp-page="/Journal">Journal des accès</a>
</div>

<section class="carte">
    <h2 class="h5">La garderie</h2>
    <form method="post" class="row g-3">
        <div class="col-md-6">
            <label asp-for="Donnees.NomGarderie" class="form-label">Nom de la garderie</label>
            <input asp-for="Donnees.NomGarderie" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.NomRsge" class="form-label">Nom de la RSGE (sur la fiche)</label>
            <input asp-for="Donnees.NomRsge" class="form-control" />
        </div>
        <div class="col-4 col-md-2">
            <label asp-for="Donnees.Rl24Appartement" class="form-label">App.</label>
            <input asp-for="Donnees.Rl24Appartement" class="form-control" maxlength="10" />
        </div>
        <div class="col-8 col-md-2">
            <label asp-for="Donnees.Rl24Numero" class="form-label">Numéro</label>
            <input asp-for="Donnees.Rl24Numero" class="form-control" maxlength="20" />
        </div>
        <div class="col-md-8">
            <label asp-for="Donnees.Rl24Rue" class="form-label">Rue, case postale</label>
            <input asp-for="Donnees.Rl24Rue" class="form-control" maxlength="100" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.Rl24Ville" class="form-label">Ville</label>
            <input asp-for="Donnees.Rl24Ville" class="form-control" maxlength="60" />
        </div>
        <div class="col-4 col-md-2">
            <label asp-for="Donnees.Rl24Province" class="form-label">Province</label>
            <input asp-for="Donnees.Rl24Province" class="form-control" maxlength="2" />
        </div>
        <div class="col-8 col-md-4">
            <label asp-for="Donnees.Rl24CodePostal" class="form-label">Code postal</label>
            <input asp-for="Donnees.Rl24CodePostal" class="form-control" maxlength="7" autocomplete="postal-code" />
        </div>
        <div class="col-12 form-text mt-0">Comme sur les formulaires de Revenu Québec ; le contrat et la régie reprennent cette adresse.</div>
        <div class="col-md-6">
            <label asp-for="Donnees.Telephone" class="form-label">Téléphone</label>
            <input asp-for="Donnees.Telephone" type="tel" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.CourrielRsge" class="form-label">Courriel de la RSGE (reçoit les PDF signés)</label>
            <input asp-for="Donnees.CourrielRsge" type="email" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.NomBureauCoordonnateur" class="form-label">Bureau coordonnateur (sur la fiche)</label>
            <input asp-for="Donnees.NomBureauCoordonnateur" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.DebutPeriodes" class="form-label">Un lundi qui commence une période de 2 semaines</label>
            <input asp-for="Donnees.DebutPeriodes" type="date" class="form-control" />
            <div class="form-text">Ex. 19 octobre 2026 : périodes du 19 oct. au 1er nov., du 2 au 15 nov., etc.</div>
        </div>
        <div class="col-md-3">
            <label asp-for="Donnees.HeureOuverture" class="form-label">Ouverture</label>
            <input asp-for="Donnees.HeureOuverture" type="time" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Donnees.HeureFermeture" class="form-label">Fermeture</label>
            <input asp-for="Donnees.HeureFermeture" type="time" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.LienFacebook" class="form-label">Groupe Facebook des parents</label>
            <input asp-for="Donnees.LienFacebook" type="url" class="form-control" placeholder="https://www.facebook.com/groups/…" maxlength="300" />
            <div class="form-text">Ajouté aux courriels envoyés aux parents et en haut de la régie interne.</div>
        </div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Enregistrer</button></div>
    </form>
</section>

<section class="carte" id="rl24">
    <h2 class="h5">Relevé 24 (Revenu Québec)</h2>
    <p class="small text-muted">Pour les relevés 24 remis aux parents et le sommaire 24, au plus tard le dernier jour de février.
        Téléchargez sur revenuquebec.ca la version « PDF remplissable à l'écran » du RL-24 et du RL-24.S, puis téléversez-les ici
        (chaque année, si Revenu Québec publie une nouvelle version).</p>
    <ul class="list-group mb-3">
        @foreach (var (quel, libelle, present) in new[] { ("releve", "Relevé 24 (RL-24)", Model.Rl24Present), ("sommaire", "Sommaire 24 (RL-24.S)", Model.Rl24SPresent) })
        {
            <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
                <span class="me-auto"><strong>@libelle</strong>
                    @if (present) { <span class="badge text-bg-success">Enregistré</span> } else { <span class="badge text-bg-light border">À téléverser</span> }</span>
                @if (present)
                {
                    <a class="btn btn-sm btn-doux" asp-page-handler="ApercuRl24" asp-route-quel="@quel" target="_blank" rel="noopener">Aperçu</a>
                }
                <form method="post" asp-page-handler="FormulaireRl24" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                    <input type="hidden" name="quel" value="@quel" />
                    <input type="file" name="fichier" accept="application/pdf,.pdf" class="form-control form-control-sm w-auto" required aria-label="@libelle" />
                    <button type="submit" class="btn btn-sm btn-doux">Téléverser</button>
                </form>
            </li>
        }
    </ul>
    @if (Model.Rl24ProchainNumero is { } prochain)
    {
        <p class="small">Prochain numéro de relevé : <strong>@prochain</strong> (calculé comme le fait le formulaire de Revenu Québec).
            L'aperçu utilise vos Réglages avec un parent et un enfant fictifs ; il ne réserve pas de numéro.</p>
    }
    <form method="post" asp-page-handler="Rl24" class="row g-3">
        <div class="col-md-6">
            <label asp-for="Rl24.Identifiant" class="form-label">Case H : votre NEQ, ou votre NAS si vous n'avez pas de NEQ</label>
            <input asp-for="Rl24.Identifiant" class="form-control" inputmode="numeric" autocomplete="off" maxlength="14"
                   placeholder="@(Model.IdentifiantEnregistre ? "" : "NEQ (10 chiffres) ou NAS (9 chiffres)")" />
            <div class="form-text">Chiffré dans la base. Laissez tel quel pour le garder.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="Rl24.Signataire" class="form-label">Signataire du sommaire (nom et fonction)</label>
            <input asp-for="Rl24.Signataire" class="form-control" maxlength="100" placeholder="ex. Sonia Savard, responsable" />
        </div>
        <div class="col-12 small text-muted">L'adresse inscrite sur les relevés est celle de « La garderie », plus haut.</div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Enregistrer</button></div>
    </form>
</section>

<section class="carte" id="logo">
    <h2 class="h5">Logo</h2>
    <p class="small text-muted">Affiché en haut de l'application et des pages des parents, à la place du petit bateau. PNG ou JPG, idéalement carré.</p>
    <div class="d-flex flex-wrap gap-3 align-items-center">
        @if (Model.LogoPresent)
        {
            <img class="apercu-logo" src="@Url.Page("/Public/Logo", new { v = System.IO.File.GetLastWriteTimeUtc(Model.CheminLogo).Ticks })" alt="Logo actuel" />
        }
        <form method="post" asp-page-handler="Logo" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
            <input type="file" name="logo" accept="image/png,image/jpeg" class="form-control w-auto" required aria-label="Logo" />
            <button type="submit" class="btn btn-doux">Téléverser</button>
        </form>
        @if (Model.LogoPresent)
        {
            <form method="post" asp-page-handler="RetirerLogo" class="confirmer" data-confirmer="Retirer le logo ?">
                <button type="submit" class="btn btn-outline-secondary">Retirer</button>
            </form>
        }
    </div>
</section>

<section class="carte" id="aide">
    <h2 class="h5">Vidéo d'aide</h2>
    <p class="small text-muted">Montrée dans l'onglet « Aide ». MP4, 15 Mo maximum.</p>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (Model.VideoAidePresente)
        {
            <a class="btn btn-outline-secondary" asp-page="/Aide">Voir</a>
        }
        <form method="post" asp-page-handler="VideoAide" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
            <input type="file" name="video" accept="video/mp4" class="form-control w-auto" required aria-label="Vidéo d'aide" />
            <button type="submit" class="btn btn-doux">Téléverser</button>
        </form>
        @if (Model.VideoAidePresente)
        {
            <form method="post" asp-page-handler="RetirerVideoAide" class="confirmer" data-confirmer="Retirer la vidéo d'aide ?">
                <button type="submit" class="btn btn-outline-secondary">Retirer</button>
            </form>
        }
    </div>
</section>

<section class="carte">
    <h2 class="h5">Formulaire FO-0310 (fiche d'assiduité vierge)</h2>
    @if (Model.ModeleDisponible)
    {
        <p class="mb-2"><span class="badge text-bg-success">Enregistré</span> le @Affichage.Horodatage(Model.ModeleDate!.Value).
            Remplacez-le si le ministère publie une nouvelle version.</p>
    }
    else
    {
        <p class="mb-2">Téléversez le PDF à remplir du ministère de la Famille (FO-0310), fourni par le bureau coordonnateur.</p>
    }
    <form method="post" asp-page-handler="Modele" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
        <input type="file" name="modele" accept="application/pdf,.pdf" class="form-control w-auto" required aria-label="Formulaire FO-0310" />
        <button type="submit" class="btn btn-doux">Téléverser</button>
    </form>
</section>

<section class="carte">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h2 class="h5 mb-0 me-auto">Contrat (entente de service)</h2>
        <a class="btn btn-doux btn-sm" asp-page-handler="ContratModele" target="_blank" rel="noopener">Aperçu du modèle de contrat</a>
    </div>
    <p class="small text-muted">Le nom, l'adresse, le téléphone et les heures viennent de « La garderie » ci-dessus ; les fermetures et
        vacances viennent de la page Fermetures. Les textes s'appliquent aux contrats pas encore signés par le parent.
        Dans « Attestation », {garderie} et {rsge} sont remplacés par les noms. Une ligne qui commence par « - » devient un point.</p>
    <form method="post" asp-page-handler="Contrat" class="row g-3">
        <div class="col-md-4">
            <label asp-for="Contrat.VilleSignature" class="form-label">Ville de signature</label>
            <input asp-for="Contrat.VilleSignature" class="form-control" placeholder="ex. Québec" />
        </div>
        <div class="col-md-8">
            <label asp-for="Contrat.NoteVacances" class="form-label">Note sur les vacances (facultatif)</label>
            <input asp-for="Contrat.NoteVacances" class="form-control" placeholder="ex. Semaine des fêtes : à confirmer avec le calendrier scolaire" />
        </div>
        <div class="col-12">
            <label asp-for="Contrat.ObligationsRsge" class="form-label">Obligations de l'éducatrice</label>
            <textarea asp-for="Contrat.ObligationsRsge" class="form-control" rows="6"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.ObligationsParent" class="form-label">Obligations du parent</label>
            <textarea asp-for="Contrat.ObligationsParent" class="form-control" rows="6"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.MentionLpc" class="form-label">Mention exigée par la Loi sur la protection du consommateur</label>
            <textarea asp-for="Contrat.MentionLpc" class="form-control" rows="6"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.Attestation" class="form-label">Attestation</label>
            <textarea asp-for="Contrat.Attestation" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.NonRespect" class="form-label">Non-respect de l'entente</label>
            <textarea asp-for="Contrat.NonRespect" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-12 small fw-bold mt-4">Sections du modèle du bureau coordonnateur</div>
        <div class="col-md-4">
            <label asp-for="Contrat.HeureCollationMatin" class="form-label">Collation du matin vers</label>
            <input asp-for="Contrat.HeureCollationMatin" class="form-control" placeholder="ex. 9 h 00" maxlength="20" />
        </div>
        <div class="col-md-4">
            <label asp-for="Contrat.HeureDiner" class="form-label">Dîner vers</label>
            <input asp-for="Contrat.HeureDiner" class="form-control" placeholder="ex. 11 h 00" maxlength="20" />
        </div>
        <div class="col-md-4">
            <label asp-for="Contrat.HeureCollationPm" class="form-label">Collation de l'après-midi vers</label>
            <input asp-for="Contrat.HeureCollationPm" class="form-control" placeholder="ex. 15 h 00" maxlength="20" />
        </div>
        <div class="col-md-4">
            <label asp-for="Contrat.FraisNsf" class="form-label">Frais d'un chèque sans provision ($)</label>
            <input asp-for="Contrat.FraisNsf" class="form-control" placeholder="ex. 25,00" maxlength="20" />
        </div>
        <div class="col-md-4">
            <label asp-for="Contrat.RetardMontant" class="form-label">Frais de retard : montant ($)</label>
            <input asp-for="Contrat.RetardMontant" class="form-control" placeholder="ex. 5,00" maxlength="20" />
        </div>
        <div class="col-md-4">
            <label asp-for="Contrat.RetardMinutes" class="form-label">… par tranche de (minutes)</label>
            <input asp-for="Contrat.RetardMinutes" class="form-control" placeholder="ex. 5" maxlength="20" />
        </div>
        <div class="col-12">
            <label asp-for="Contrat.Services" class="form-label">Description des services fournis</label>
            <textarea asp-for="Contrat.Services" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.ClausesFermeture" class="form-label">Fermetures : avis des vacances et frais</label>
            <textarea asp-for="Contrat.ClausesFermeture" class="form-control" rows="5"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.ResiliationRsge" class="form-label">Résiliation de l'entente par l'éducatrice</label>
            <textarea asp-for="Contrat.ResiliationRsge" class="form-control" rows="6"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.ResiliationParent" class="form-label">Résiliation de l'entente par le parent</label>
            <textarea asp-for="Contrat.ResiliationParent" class="form-control" rows="2"></textarea>
        </div>
        <div class="col-12 form-text mt-0">Le tarif, le jour de paiement, les modes de paiement et les frais de retard viennent de la régie interne, plus bas ;
            les jours de fréquentation viennent de l'horaire de l'enfant, aux heures d'ouverture.</div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Enregistrer les textes</button>
            <span class="small text-muted ms-2">Enregistrez avant l'aperçu pour voir vos changements.</span></div>
    </form>
</section>

<section class="carte" id="regie">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h2 class="h5 mb-0 me-auto">Régie interne</h2>
        <a class="btn btn-doux btn-sm" asp-page-handler="RegiePdf" target="_blank" rel="noopener">Afficher le PDF</a>
        <a class="btn btn-doux btn-sm" asp-page-handler="RegiePdf" asp-route-telecharger="true">Télécharger</a>
    </div>
    <p class="small text-muted">Le PDF est généré par l'application, joint au courriel du contrat et offert sur la page de signature.
        Le nom, les heures et la liste des fériés viennent des Réglages ; la mention de la Loi sur la protection du consommateur
        vient des textes du contrat.@if (Model.RegieModifieeLe is { } m) { <text> Dernière modification : @Affichage.Horodatage(m).</text> }</p>
    <form method="post" asp-page-handler="Regie">
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label asp-for="RegieTarif" class="form-label">Tarif par jour</label>
                <input asp-for="RegieTarif" class="form-control" placeholder="ex. 45 $" maxlength="50" />
            </div>
            <div class="col-md-3">
                <label asp-for="RegieJourPaiement" class="form-label">Jour de paiement</label>
                <input asp-for="RegieJourPaiement" class="form-control" placeholder="ex. mercredi" maxlength="30" />
            </div>
            <div class="col-md-6">
                <label asp-for="RegieModesPaiement" class="form-label">Modes de paiement</label>
                <input asp-for="RegieModesPaiement" class="form-control" maxlength="100" />
            </div>
            <div class="col-md-6">
                <label asp-for="RegieFraisRetard" class="form-label">Frais de retard (fin de journée)</label>
                <input asp-for="RegieFraisRetard" class="form-control" placeholder="ex. 5 $ pour les 10 premières minutes et ensuite 1 $ la minute" maxlength="200" />
            </div>
        </div>
        @foreach (var partie in Garderie.Web.Services.RegieInterne.Sections.GroupBy(x => x.Partie))
        {
            <details class="partie-regie">
                <summary class="fw-bold">@partie.Key <span class="small text-muted fw-normal">(@partie.Count() section@(partie.Count() > 1 ? "s" : ""))</span></summary>
                @foreach (var sec in partie)
                {
                    var id = "regie-" + sec.Cle;
                    var texte = Model.Regie.GetValueOrDefault(sec.Cle) ?? sec.Texte;
                    <div class="mt-2">
                        <label class="form-label mb-1" for="@id">@(sec.Titre ?? sec.Partie)
                            @if (Model.RegieModifiees.Contains(sec.Cle)) { <span class="badge text-bg-light border">modifiée</span> }</label>
                        <textarea class="form-control texte-regie" id="@id" name="Regie[@sec.Cle]" rows="@Math.Clamp(texte.Length / 90 + texte.Count(c => c == '\n') + 1, 2, 18)">@texte</textarea>
                    </div>
                }
            </details>
        }
        <div class="form-text">@Garderie.Web.Services.RegieInterne.Aide</div>
        <button type="submit" class="btn btn-primary mt-2">Enregistrer la régie interne</button>
    </form>
</section>

<section class="carte">
    <h2 class="h5">Courriel</h2>
    <dl class="row small-dl mb-2">
        <dt class="col-sm-4">Envoi</dt>
        <dd class="col-sm-8">@(Model.CourrielConfigure ? $"configuré ({Model.CompteCourriel})" : "non configuré")</dd>
        <dt class="col-sm-4">Adresse publique</dt>
        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.UrlPublique) ? "non configurée" : Model.UrlPublique)</dd>
    </dl>
    <p class="small text-muted">Le compte Gmail, son mot de passe d'application et l'adresse publique se règlent dans
        Home Assistant : Paramètres → Modules → Garderie → Configuration.</p>
    <form method="post" asp-page-handler="TestCourriel">
        <button type="submit" class="btn btn-doux" disabled="@(!Model.CourrielConfigure)">Envoyer un courriel de test à la RSGE</button>
    </form>
</section>
