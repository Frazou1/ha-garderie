@page
@model FermeturesModel
@{
    ViewData["Title"] = "Fermetures";
}
<h1 class="h3 mb-3">Jours de fermeture</h1>
<p class="text-muted">Les enfants prévus ces jours-là auront « F » proposé dans les présences.</p>

<form method="post" class="row g-2 align-items-end mb-4">
    <div class="col-sm-3">
        <label class="form-label small mb-0" for="debut">Du</label>
        <input type="date" name="debut" id="debut" class="form-control" required />
    </div>
    <div class="col-sm-3">
        <label class="form-label small mb-0" for="fin">Au (facultatif)</label>
        <input type="date" name="fin" id="fin" class="form-control" />
    </div>
    <div class="col-sm-2">
        <label class="form-label small mb-0" for="demi">Durée</label>
        <select name="demi" id="demi" class="form-select">
            <option value="">Journée</option>
            <option value="Matin">Matin</option>
            <option value="Pm">Après-midi</option>
        </select>
    </div>
    <div class="col-sm-3">
        <label class="form-label small mb-0" for="motif">Motif</label>
        <input name="motif" id="motif" class="form-control" maxlength="200" placeholder="ex. Vacances, journée pédagogique" />
    </div>
    <div class="col-sm-1"><button class="btn btn-primary w-100" type="submit">Ajouter</button></div>
</form>

<form method="post" asp-page-handler="Feries" class="d-flex flex-wrap gap-2 align-items-center mb-4">
    <label class="small" for="annee">Jours fériés du Québec (repris dans les contrats) :</label>
    <input type="number" name="annee" id="annee" class="form-control w-auto" min="2020" max="2100" value="@(Temps.Aujourdhui().Year + (Temps.Aujourdhui().Month >= 9 ? 1 : 0))" />
    <button class="btn btn-doux" type="submit">Ajouter les fériés de l'année</button>
</form>

<div class="mb-2">
    @if (Model.Passees)
    {
        <a asp-page="Fermetures">Masquer les anciennes</a>
    }
    else
    {
        <a asp-page="Fermetures" asp-route-passees="true">Voir aussi les anciennes</a>
    }
</div>
<ul class="list-group col-lg-8">
    @if (Model.Fermetures.Count == 0)
    {
        <li class="list-group-item text-muted">Aucune fermeture à venir.</li>
    }
    @foreach (var f in Model.Fermetures)
    {
        <li class="list-group-item d-flex align-items-center gap-2">
            <span class="fw-semibold">@Affichage.Jour(f.Date.DayOfWeek) @Affichage.Date(f.Date)</span>
            <span class="badge text-bg-light border">@(f.Demi switch { DemiJournee.Matin => "Matin", DemiJournee.Pm => "Après-midi", _ => "Journée" })</span>
            <span class="me-auto text-muted">@f.Motif</span>
            <form method="post" asp-page-handler="Supprimer">
                <input type="hidden" name="id" value="@f.Id" />
                <button class="btn btn-sm btn-outline-danger" type="submit">Retirer</button>
            </form>
        </li>
    }
</ul>
