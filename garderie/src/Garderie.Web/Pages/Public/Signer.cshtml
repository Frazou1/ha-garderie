@page
@model Garderie.Web.Pages.Public.SignerModel
@using Garderie.Web.Pages.Shared
@{
    Layout = "_LayoutPublic";
    ViewData["Title"] = "Fiche d'assiduité";
    var nomGarderie = Model.Garderie?.NomGarderie ?? "Garderie";
    var plusieurs = Model.Fiches.Count > 1;
}
@if (Model.Termine || Model.DejaSignee)
{
    <div class="carte carte-publique mx-auto text-center">
        <h1 class="h4">Merci !</h1>
        <p class="mb-0">@(plusieurs ? "Les fiches sont signées" : "La fiche est signée"). Votre éducatrice en reçoit une copie.
            Vous pouvez fermer cette page.</p>
        @if (Model.Lien?.SurPlace == true && User.Identity?.IsAuthenticated == true && Model.Fiches.Count > 0)
        {
            <a class="btn btn-doux mt-3" asp-page="/Fiches/Index" asp-route-periode="@Model.Fiches[0].Debut.ToString("yyyy-MM-dd")">Retour aux fiches</a>
        }
    </div>
}
else if (Model.ErreurEnvoyee)
{
    <div class="carte carte-publique mx-auto text-center">
        <h1 class="h4">Message envoyé</h1>
        <p class="mb-0">Votre éducatrice va vérifier et vous renverra une version corrigée.</p>
    </div>
}
else if (Model.Lien is null)
{
    <div class="carte carte-publique mx-auto">
        <h1 class="h4">Lien invalide ou expiré</h1>
        <p class="mb-0">Ce lien a déjà été utilisé ou n'est plus valide. Demandez-en un nouveau à votre éducatrice.</p>
    </div>
}
else
{
    var premiere = Model.Fiches[0];
    <div class="carte-publique mx-auto">
        <p class="sous-titre mb-1">@nomGarderie</p>
        <h1 class="titre-page mb-1">@(plusieurs ? "Fiches" : "Fiche") d'assiduité de @Model.Prenoms</h1>
        <p class="sous-titre">Du @Affichage.Periode(premiere.Debut, premiere.Fin)</p>

        <div asp-validation-summary="All" class="bulle bulle-erreur"></div>

        @foreach (var f in Model.Fiches)
        {
            var grille = new GrilleFicheVue(f.Debut, Model.Codes[f.Id], f.Enfant);
            <section class="carte">
                @if (plusieurs)
                {
                    <h2 class="h5 mb-1">@f.Enfant.Prenom @f.Enfant.Nom</h2>
                }
                <partial name="_GrilleFiche" model="grille" />
                @if (Garderie.Web.Pages.Public.SignerModel.PaiementSaisi(f))
                {
                    <h3 class="h6 mt-3">Contribution réduite</h3>
                    <dl class="row small-dl mb-0 small">
                        <dt class="col-5">Semaine du @Affichage.Date(f.Debut)</dt>
                        <dd class="col-7">payé le @Affichage.Date(f.DatePaiement1) : @(f.MontantPaye1?.ToString("0.00") ?? "—") $ · solde @(f.Solde1?.ToString("0.00") ?? "—") $</dd>
                        <dt class="col-5">Semaine du @Affichage.Date(f.Debut.AddDays(7))</dt>
                        <dd class="col-7">payé le @Affichage.Date(f.DatePaiement2) : @(f.MontantPaye2?.ToString("0.00") ?? "—") $ · solde @(f.Solde2?.ToString("0.00") ?? "—") $</dd>
                    </dl>
                }
            </section>
        }

        <details class="legende">
            <summary>Que veulent dire les codes ?</summary>
            <dl>
                @foreach (var c in CodesPresence.Tous)
                {
                    <div><dt><span class="pastille @Affichage.ClasseCode(c.Valeur)">@CodesPresence.Court(c.Valeur)</span></dt><dd>@c.Libelle</dd></div>
                }
            </dl>
        </details>
        <p class="small text-muted">Signée par @(Model.Garderie?.NomRsge ?? "la RSGE") le @Affichage.Date(DateOnly.FromDateTime(Temps.VersLocal(premiere.SigneRsgeLe!.Value))).</p>

        <section class="carte">
            <h2 class="h6">Votre signature@(plusieurs ? $" (pour les {Model.Fiches.Count} fiches)" : "")</h2>
            <form method="post" asp-page-handler="Signer" asp-route-j="@Model.Jeton" class="form-signature">
                <div class="attestation">
                    <p class="texte">J'atteste que les renseignements inscrits sur @(plusieurs ? "ces fiches" : "cette fiche") d'assiduité
                        correspondent à la présence réelle de @(plusieurs ? "mes enfants" : "mon enfant") et aux contributions réduites payées et à payer.</p>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="atteste" value="true" id="atteste" required />
                        <label class="form-check-label" for="atteste">Je confirme</label>
                    </div>
                </div>
                <label class="form-label small mb-0" for="nom">Votre nom</label>
                <input class="form-control mb-2" id="nom" name="nom" value="@premiere.NomParent" maxlength="200" required autocomplete="name" />
                <canvas class="pad-signature" width="600" height="200" aria-label="Signez ici avec le doigt"></canvas>
                <input type="hidden" name="signature" class="valeur-signature" />
                <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary effacer-signature">Effacer</button>
                    <button type="submit" class="btn btn-primary btn-lg ms-auto">Signer</button>
                </div>
            </form>
        </section>

        <details class="carte">
            <summary class="fw-bold">Un code vous semble inexact ? Signaler une erreur</summary>
            <form method="post" asp-page-handler="Erreur" asp-route-j="@Model.Jeton" class="mt-2">
                <textarea class="form-control mb-2" name="message" rows="3" maxlength="1000" required
                          placeholder="Ex. Le mardi 4, mon enfant était absent."></textarea>
                <button type="submit" class="btn btn-doux">Envoyer à l'éducatrice</button>
            </form>
        </details>
    </div>
}
