@page
@model Garderie.Web.Pages.Presences.IndexModel
@{
    ViewData["Title"] = "Présences";
    var lundi = Model.Lundi;
    var i = 0;
    var cetteSemaine = Garderie.Web.Services.PresencesService.Lundi(Model.Aujourdhui);
}
<div class="entete-page">
    <div>
        <h1 class="titre-page">Présences</h1>
        <p class="sous-titre">Semaine du @Affichage.Periode(Model.Jours[0], Model.Jours[^1])</p>
    </div>
    <nav class="nav-semaine" aria-label="Changer de semaine">
        <a class="btn btn-rond" asp-page="Index" asp-route-semaine="@lundi.AddDays(-7).ToString("yyyy-MM-dd")" aria-label="Semaine précédente">‹</a>
        @if (lundi != cetteSemaine)
        {
            <a class="btn btn-doux" asp-page="Index">Cette semaine</a>
        }
        <a class="btn btn-rond" asp-page="Index" asp-route-semaine="@lundi.AddDays(7).ToString("yyyy-MM-dd")" aria-label="Semaine suivante">›</a>
    </nav>
</div>

@if (Model.Lignes.Count == 0)
{
    <div class="carte vide">
        <p class="mb-2">Aucun enfant inscrit cette semaine.</p>
        <a class="btn btn-primary" asp-page="/Enfants/Edition">Ajouter un enfant</a>
    </div>
}
else
{
    <form method="post" asp-route-semaine="@lundi.ToString("yyyy-MM-dd")">
        @if (Model.AuMoinsUnPropose)
        {
            <p class="aide">Les cases en pointillé sont <strong>proposées</strong> (P, ou F les jours de fermeture).
                Touchez une case pour la changer, puis <strong>Enregistrez</strong>.</p>
        }
        @foreach (var l in Model.Lignes)
        {
            var e = l.Enfant;
            var photo = e.PhotoDocumentId is { } pid ? Url.Page("/Enfants/Dossier", "Document", new { id = e.Id, documentId = pid, apercu = true }) : null;
            <section class="carte carte-presence">
                <a class="enfant-entete" asp-page="/Enfants/Dossier" asp-route-id="@e.Id">
                    <partial name="_Avatar" model="new Garderie.Web.Pages.Shared.AvatarVue(e.NomComplet, Affichage.Initiales(e.Prenom, e.Nom), e.Id, photo)" />
                    <span class="enfant-nom">@e.Prenom <span class="text-muted fw-normal">@e.Nom</span></span>
                </a>
                <div class="grille-semaine">
                    @foreach (var j in l.Jours)
                    {
                        var classeJour = j.Date == Model.Aujourdhui ? "jour aujourdhui" : "jour";
                        <div class="@classeJour">
                            <span class="jour-nom">@Affichage.JourCourt(j.Date.DayOfWeek) <b>@j.Date.Day</b></span>
                            @if (!j.Inscrit)
                            {
                                <span class="code code-hors" title="Pas inscrit ce jour-là">·</span>
                            }
                            else
                            {
                                var etat = j.Enregistre ? "enregistre" : j.Code == "" ? "" : "propose";
                                <input type="hidden" name="codes[@i].EnfantId" value="@e.Id" />
                                <input type="hidden" name="codes[@i].Date" value="@j.Date.ToString("yyyy-MM-dd")" />
                                <select name="codes[@i].Code" class="code @Affichage.ClasseCode(j.Code) @etat" aria-label="@e.Prenom, @Affichage.Jour(j.Date.DayOfWeek) @j.Date.Day">
                                    <option value="" selected="@(j.Code == "")">—</option>
                                    @foreach (var c in CodesPresence.Tous)
                                    {
                                        <option value="@c.Valeur" title="@c.Libelle" selected="@(j.Code == c.Valeur)">@CodesPresence.Court(c.Valeur)</option>
                                    }
                                </select>
                                i++;
                            }
                        </div>
                    }
                </div>
            </section>
        }
        <details class="legende">
            <summary>Que veulent dire les codes ?</summary>
            <dl>
                @foreach (var c in CodesPresence.Tous)
                {
                    <div><dt><span class="pastille @Affichage.ClasseCode(c.Valeur)">@CodesPresence.Court(c.Valeur)</span></dt><dd>@c.Libelle</dd></div>
                }
            </dl>
        </details>
        <div class="barre-enregistrer">
            <button type="submit" class="btn btn-primary btn-lg w-100">Enregistrer la semaine</button>
        </div>
    </form>
}
