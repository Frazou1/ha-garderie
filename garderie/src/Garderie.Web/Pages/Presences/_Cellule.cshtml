@model Garderie.Web.Pages.Presences.CelluleVue
@{
    var i = Model.Index;
    var code = Model.Case.Code;
    var estRapide = Garderie.Web.Pages.Presences.IndexModel.CodesRapides.Contains(code) || code == "";
    var classe = Model.Case.Enregistre ? "enregistre" : code == "" ? "" : "propose";
}
<fieldset class="cellule @classe">
    <legend class="small mb-1">@Model.Libelle @if (Model.Case.Prevu) { <span class="text-success">• prévu</span> }</legend>
    <input type="hidden" name="codes[@i].EnfantId" value="@Model.EnfantId" />
    <input type="hidden" name="codes[@i].Demi" value="@Model.Demi" />
    <div class="btn-group flex-wrap codes" role="group">
        @foreach (var c in Garderie.Web.Pages.Presences.IndexModel.CodesRapides.Append(""))
        {
            var id = $"c{i}-{c.Replace(" 1/2", "d")}{(c == "" ? "vide" : "")}";
            <input type="radio" class="btn-check" name="codes[@i].Code" id="@id" value="@c" autocomplete="off" checked="@(estRapide && code == c)" />
            <label class="btn btn-outline-@(c == "" ? "secondary" : c.StartsWith("P") ? "success" : c.StartsWith("A") ? "danger" : "dark")" for="@id" title="@CodesPresence.Libelle(c)">@(c == "" ? "—" : CodesPresence.Court(c))</label>
        }
    </div>
    <select name="codes[@i].Autre" class="form-select form-select-sm mt-1 autre" aria-label="Autre code">
        <option value="">Autre code…</option>
        @foreach (var c in Garderie.Web.Pages.Presences.IndexModel.CodesAutres)
        {
            <option value="@c.Valeur" selected="@(!estRapide && code == c.Valeur)">@CodesPresence.Court(c.Valeur) — @c.Libelle</option>
        }
    </select>
</fieldset>
