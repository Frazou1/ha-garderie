<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fdf6ee" />
    <title>@ViewData["Title"] – Garderie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Actif(string prefixe) => page.StartsWith(prefixe, StringComparison.OrdinalIgnoreCase) ? "actif" : "";
    var onglets = new (string Page, string Prefixe, string Libelle, string Icone, bool EnBas)[]
    {
        ("/Presences/Index", "/Presences", "Présences", "M8 2v4M16 2v4M3 9h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8.5 15l2.5 2.5 4.5-5", true),
        ("/Fiches/Index", "/Fiches", "Fiches", "M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M8.5 17c1.2-1.6 2.2-2.4 3-2.4 1.3 0 .7 2.4 2 2.4.6 0 1.2-.5 2-1.4", true),
        ("/Enfants/Index", "/Enfants", "Enfants", "M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1M17 3.5a4 4 0 0 1 0 7.5M19 14a5 5 0 0 1 3 5v2", true),
        ("/Fermetures", "/Fermetures", "Fermetures", "M3 21h18M5 21V8l7-5 7 5v13M10 21v-6h4v6M9.5 10.5l5 0", true),
        ("/Journal", "/Journal", "Journal", "M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01", false),
        ("/Parametres", "/Parametres", "Réglages", "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z", true),
    };
}
<body>
    <header class="barre-haut">
        <a class="marque" asp-page="/Index">
            <svg class="marque-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11M12 4l6 8h-6M5 17h14l-2 3H7z M3 17c2 0 2-1 4-1s2 1 4 1 2-1 4-1 2 1 4 1 2-1 2-1" /></svg>
            <span>Les petits moussaillons</span>
        </a>
        <nav class="nav-haut" aria-label="Menu">
            @foreach (var o in onglets)
            {
                <a class="@Actif(o.Prefixe)" asp-page="@o.Page">@o.Libelle</a>
            }
        </nav>
        <span class="utilisateur">@(User.FindFirst("nom_affiche")?.Value ?? User.Identity?.Name)</span>
    </header>

    <main class="contenu">
        @if (TempData["Message"] is string message)
        {
            <div class="bulle bulle-ok" role="status">@message</div>
        }
        @if (TempData["Erreur"] is string erreur)
        {
            <div class="bulle bulle-erreur" role="alert">@erreur</div>
        }
        @RenderBody()
    </main>

    <nav class="onglets-bas" aria-label="Menu">
        @foreach (var o in onglets.Where(o => o.EnBas))
        {
            <a class="@Actif(o.Prefixe)" asp-page="@o.Page">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@o.Icone" /></svg>
                <span>@o.Libelle</span>
            </a>
        }
    </nav>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
