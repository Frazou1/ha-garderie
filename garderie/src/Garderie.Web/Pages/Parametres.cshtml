@page
@model ParametresModel
@{
    ViewData["Title"] = "Réglages";
}
<div class="entete-page">
    <div>
        <h1 class="titre-page">Réglages</h1>
        <p class="sous-titre">Garderie, fiches d'assiduité et courriel</p>
    </div>
    <a class="btn btn-doux btn-sm" asp-page="/Journal">Journal des accès</a>
</div>

<section class="carte">
    <h2 class="h5">La garderie</h2>
    <form method="post" class="row g-3">
        <div class="col-md-6">
            <label asp-for="Donnees.NomGarderie" class="form-label">Nom de la garderie</label>
            <input asp-for="Donnees.NomGarderie" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.NomRsge" class="form-label">Nom de la RSGE (sur la fiche)</label>
            <input asp-for="Donnees.NomRsge" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Donnees.Adresse" class="form-label">Adresse</label>
            <input asp-for="Donnees.Adresse" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.Telephone" class="form-label">Téléphone</label>
            <input asp-for="Donnees.Telephone" type="tel" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.CourrielRsge" class="form-label">Courriel de la RSGE (reçoit les PDF signés)</label>
            <input asp-for="Donnees.CourrielRsge" type="email" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.NomBureauCoordonnateur" class="form-label">Bureau coordonnateur (sur la fiche)</label>
            <input asp-for="Donnees.NomBureauCoordonnateur" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Donnees.DebutPeriodes" class="form-label">Un lundi qui commence une période de 2 semaines</label>
            <input asp-for="Donnees.DebutPeriodes" type="date" class="form-control" />
            <div class="form-text">Ex. 19 octobre 2026 : périodes du 19 oct. au 1er nov., du 2 au 15 nov., etc.</div>
        </div>
        <div class="col-md-3">
            <label asp-for="Donnees.HeureOuverture" class="form-label">Ouverture</label>
            <input asp-for="Donnees.HeureOuverture" type="time" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Donnees.HeureFermeture" class="form-label">Fermeture</label>
            <input asp-for="Donnees.HeureFermeture" type="time" class="form-control" />
        </div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Enregistrer</button></div>
    </form>
</section>

<section class="carte">
    <h2 class="h5">Formulaire FO-0310 (fiche d'assiduité vierge)</h2>
    @if (Model.ModeleDisponible)
    {
        <p class="mb-2"><span class="badge text-bg-success">Enregistré</span> le @Affichage.Horodatage(Model.ModeleDate!.Value).
            Remplacez-le si le ministère publie une nouvelle version.</p>
    }
    else
    {
        <p class="mb-2">Téléversez le PDF à remplir du ministère de la Famille (FO-0310), fourni par le bureau coordonnateur.</p>
    }
    <form method="post" asp-page-handler="Modele" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
        <input type="file" name="modele" accept="application/pdf,.pdf" class="form-control w-auto" required aria-label="Formulaire FO-0310" />
        <button type="submit" class="btn btn-doux">Téléverser</button>
    </form>
</section>

<section class="carte">
    <h2 class="h5">Contrat (entente de service)</h2>
    <p class="small text-muted">Le nom, l'adresse, le téléphone et les heures viennent de « La garderie » ci-dessus ; les fermetures et
        vacances viennent de la page Fermetures. Les textes s'appliquent aux contrats pas encore signés par le parent.
        Dans « Attestation », {garderie} et {rsge} sont remplacés par les noms. Une ligne qui commence par « - » devient un point.</p>
    <form method="post" asp-page-handler="Contrat" class="row g-3">
        <div class="col-md-4">
            <label asp-for="Contrat.VilleSignature" class="form-label">Ville de signature</label>
            <input asp-for="Contrat.VilleSignature" class="form-control" placeholder="ex. Québec" />
        </div>
        <div class="col-md-8">
            <label asp-for="Contrat.NoteVacances" class="form-label">Note sur les vacances (facultatif)</label>
            <input asp-for="Contrat.NoteVacances" class="form-control" placeholder="ex. Semaine des fêtes : à confirmer avec le calendrier scolaire" />
        </div>
        <div class="col-12">
            <label asp-for="Contrat.ObligationsRsge" class="form-label">Obligations de l'éducatrice</label>
            <textarea asp-for="Contrat.ObligationsRsge" class="form-control" rows="6"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.ObligationsParent" class="form-label">Obligations du parent</label>
            <textarea asp-for="Contrat.ObligationsParent" class="form-control" rows="6"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.MentionLpc" class="form-label">Mention exigée par la Loi sur la protection du consommateur</label>
            <textarea asp-for="Contrat.MentionLpc" class="form-control" rows="6"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.Attestation" class="form-label">Attestation</label>
            <textarea asp-for="Contrat.Attestation" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-12">
            <label asp-for="Contrat.NonRespect" class="form-label">Non-respect de l'entente</label>
            <textarea asp-for="Contrat.NonRespect" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-12"><button type="submit" class="btn btn-primary">Enregistrer les textes</button></div>
    </form>
</section>

<section class="carte" id="regie">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <h2 class="h5 mb-0 me-auto">Régie interne</h2>
        <a class="btn btn-doux btn-sm" asp-page-handler="RegiePdf" target="_blank" rel="noopener">Afficher le PDF</a>
        <a class="btn btn-doux btn-sm" asp-page-handler="RegiePdf" asp-route-telecharger="true">Télécharger</a>
    </div>
    <p class="small text-muted">Le PDF est généré par l'application, joint au courriel du contrat et offert sur la page de signature.
        Le nom, les heures et la liste des fériés viennent des Réglages ; la mention de la Loi sur la protection du consommateur
        vient des textes du contrat.@if (Model.RegieModifieeLe is { } m) { <text> Dernière modification : @Affichage.Horodatage(m).</text> }</p>
    <form method="post" asp-page-handler="Regie">
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label asp-for="RegieTarif" class="form-label">Tarif par jour</label>
                <input asp-for="RegieTarif" class="form-control" placeholder="ex. 45 $" maxlength="50" />
            </div>
            <div class="col-md-3">
                <label asp-for="RegieJourPaiement" class="form-label">Jour de paiement</label>
                <input asp-for="RegieJourPaiement" class="form-control" placeholder="ex. mercredi" maxlength="30" />
            </div>
            <div class="col-md-6">
                <label asp-for="RegieFraisRetard" class="form-label">Frais de retard (fin de journée)</label>
                <input asp-for="RegieFraisRetard" class="form-control" placeholder="ex. 5 $ pour les 10 premières minutes et ensuite 1 $ la minute" maxlength="200" />
            </div>
        </div>
        @foreach (var partie in Garderie.Web.Services.RegieInterne.Sections.GroupBy(x => x.Partie))
        {
            <details class="partie-regie">
                <summary class="fw-bold">@partie.Key <span class="small text-muted fw-normal">(@partie.Count() section@(partie.Count() > 1 ? "s" : ""))</span></summary>
                @foreach (var sec in partie)
                {
                    var id = "regie-" + sec.Cle;
                    var texte = Model.Regie.GetValueOrDefault(sec.Cle) ?? sec.Texte;
                    <div class="mt-2">
                        <label class="form-label mb-1" for="@id">@(sec.Titre ?? sec.Partie)
                            @if (Model.RegieModifiees.Contains(sec.Cle)) { <span class="badge text-bg-light border">modifiée</span> }</label>
                        <textarea class="form-control texte-regie" id="@id" name="Regie[@sec.Cle]" rows="@Math.Clamp(texte.Length / 90 + texte.Count(c => c == '\n') + 1, 2, 18)">@texte</textarea>
                    </div>
                }
            </details>
        }
        <div class="form-text">@Garderie.Web.Services.RegieInterne.Aide</div>
        <button type="submit" class="btn btn-primary mt-2">Enregistrer la régie interne</button>
    </form>
</section>

<section class="carte">
    <h2 class="h5">Polices du contrat</h2>
    <p class="small text-muted">Pour que le contrat et la régie interne en PDF aient les polices de vos modèles Word. Ces polices appartiennent à Microsoft :
        elles ne sont pas fournies avec le module. Copiez-les depuis votre ordinateur (dossier C:\Windows\Fonts) ; elles restent
        dans les données du module. Sans police, une police de remplacement est utilisée.</p>
    <ul class="list-group mb-0">
        @foreach (var (cle, libelle, exemple) in Garderie.Web.Services.PolicesPdf.Emplacements)
        {
            var present = Garderie.Web.Services.PolicesPdf.Fichier(cle) is not null;
            <li class="list-group-item">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="me-auto"><strong>@libelle</strong> <span class="small text-muted">(ex. @exemple)</span>
                        @if (present) { <span class="badge text-bg-success">Téléversée</span> } else { <span class="badge text-bg-light border">Remplacement</span> }</span>
                    <form method="post" asp-page-handler="Police" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="cle" value="@cle" />
                        <input type="file" name="police" accept=".ttf,.otf,font/ttf,font/otf" class="form-control form-control-sm w-auto" required aria-label="@libelle" />
                        <button type="submit" class="btn btn-sm btn-doux">Téléverser</button>
                    </form>
                    @if (present)
                    {
                        <form method="post" asp-page-handler="RetirerPolice">
                            <input type="hidden" name="cle" value="@cle" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Retirer</button>
                        </form>
                    }
                </div>
            </li>
        }
    </ul>
</section>

<section class="carte">
    <h2 class="h5">Courriel</h2>
    <dl class="row small-dl mb-2">
        <dt class="col-sm-4">Envoi</dt>
        <dd class="col-sm-8">@(Model.CourrielConfigure ? $"configuré ({Model.CompteCourriel})" : "non configuré")</dd>
        <dt class="col-sm-4">Adresse publique</dt>
        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.UrlPublique) ? "non configurée" : Model.UrlPublique)</dd>
    </dl>
    <p class="small text-muted">Le compte Gmail, son mot de passe d'application et l'adresse publique se règlent dans
        Home Assistant : Paramètres → Modules → Garderie → Configuration.</p>
    <form method="post" asp-page-handler="TestCourriel">
        <button type="submit" class="btn btn-doux" disabled="@(!Model.CourrielConfigure)">Envoyer un courriel de test à la RSGE</button>
    </form>
</section>
