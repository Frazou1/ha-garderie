@model (Garderie.Web.Services.LignePresence Ligne, int Index)
@{
    var l = Model.Ligne;
    var matin = new Garderie.Web.Pages.Presences.CelluleVue(Model.Index, l.Enfant.Id, DemiJournee.Matin, l.Matin, "Matin");
    var pm = new Garderie.Web.Pages.Presences.CelluleVue(Model.Index + 1, l.Enfant.Id, DemiJournee.Pm, l.Pm, "Après-midi");
}
<div class="card mb-2 ligne-presence">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <a class="fw-semibold fs-5 text-decoration-none" asp-page="/Enfants/Dossier" asp-route-id="@l.Enfant.Id">@l.Enfant.NomComplet</a>
        </div>
        <div class="row g-2">
            <div class="col-md-6"><partial name="_Cellule" model="matin" /></div>
            <div class="col-md-6"><partial name="_Cellule" model="pm" /></div>
        </div>
    </div>
</div>
